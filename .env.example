# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Set the OAuth consent screen user type to "Internal".
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
# Must match an authorised redirect URI on the OAuth client.
OAUTH2_PROXY_REDIRECT_URL=https://chartdb.nczgroup.com/oauth2/callback

# Comma-separated; subdomains of each entry are also allowed by the API.
ALLOWED_EMAIL_DOMAINS=nczgroup.com

# PostgreSQL. docker-compose builds DATABASE_URL from POSTGRES_PASSWORD;
# set DATABASE_URL directly when using an external database.
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://user:password@host:5432/chartdb?sslmode=require

# Optional: AI features (served to signed-in users only).
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=
LLM_MODEL_NAME=
HIDE_CHARTDB_CLOUD=true
DISABLE_ANALYTICS=true
