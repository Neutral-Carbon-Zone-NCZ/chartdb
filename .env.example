# Shared team login (browser password prompt). The container will not start
# without APP_PASSWORD. Generate one with: openssl rand -base64 24
APP_USERNAME=ncz
APP_PASSWORD=

# PostgreSQL. docker-compose builds DATABASE_URL from POSTGRES_PASSWORD;
# set DATABASE_URL directly when using an external database.
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://user:password@host:5432/chartdb?sslmode=require

# Optional: AI features (served to signed-in users only).
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=
LLM_MODEL_NAME=
HIDE_CHARTDB_CLOUD=true
DISABLE_ANALYTICS=true
