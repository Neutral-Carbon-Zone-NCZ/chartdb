server {
    listen       ${PUBLIC_PORT};
    listen  [::]:${PUBLIC_PORT};

    root   /usr/share/nginx/html;

    # Keep redirects relative: nginx only sees the container's port and plain
    # HTTP, so an absolute Location would send users to the wrong URL.
    absolute_redirect off;

    # Every request is checked against the API, which accepts a signed session
    # cookie (set once at /login.html, good for a year) or the old HTTP basic
    # credentials. Only the login page and the health check are open.
    auth_request     /_auth;
    auth_request_set $auth_user $upstream_http_x_auth_user;

    location = /_auth {
        internal;
        proxy_pass              http://127.0.0.1:${API_PORT}/api/auth/verify;
        proxy_http_version      1.1;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length "";
    }

    location / {
        # Send signed-out browsers to the login page instead of a bare 401.
        error_page 401 = @login;
        index  index.html index.htm;
	    try_files  $uri $uri/ /index.html;
    }

    location @login {
        auth_request off;
        return 302 /login.html?next=$request_uri;
    }

    location = /login.html {
        auth_request off;
        add_header Cache-Control "no-store";
    }

    # Issues and clears the session cookie, so it cannot require one itself.
    location /api/auth/ {
        auth_request off;
        proxy_pass http://127.0.0.1:${API_PORT};
        proxy_http_version 1.1;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:${API_PORT};
        proxy_http_version 1.1;
        # Overwrite any client-supplied value with the authenticated login.
        proxy_set_header X-Forwarded-User $remote_user;
        client_max_body_size 50m;
        proxy_read_timeout 120s;
    }

    # Written at container start by entrypoint.sh.
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    location = /ping {
        auth_request off;
        default_type text/plain;
        return 200 "OK";
    }

    error_page   500 502 503 504  /50x.html;
}
